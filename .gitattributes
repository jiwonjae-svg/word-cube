# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Explicitly declare text files you want to always be normalized and converted to LF
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
