rules_version = '2';

// =============================================================
// Firestore Security Rules for Word Cube Puzzle
// Deploy via: Firebase Console > Firestore > Rules (paste & publish)
// Or via CLI: firebase deploy --only firestore:rules
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // ===== Users Collection =====
    match /users/{userId} {
      // Anyone can read user profiles (for leaderboard display)
      allow read: if true;

      // Users can only create/update their own profile
      allow create: if isOwner(userId)
        && request.resource.data.id is string
        && request.resource.data.email is string
        && isValidString(request.resource.data.name, 30);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.name, 30);

      // Users can only delete their own profile
      allow delete: if isOwner(userId);
    }

    // ===== Scores Collection =====
    match /scores/{scoreId} {
      // Anyone can read scores (leaderboard)
      allow read: if true;

      // Only authenticated users can create scores
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.userName, 30)
        && request.resource.data.cubeSize is int
        && request.resource.data.cubeSize >= 2
        && request.resource.data.cubeSize <= 10
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.time < 86400
        && request.resource.data.valid == true;

      // Scores should not be updated or deleted by users
      allow update, delete: if false;
    }

    // ===== Play History Collection =====
    match /history/{historyId} {
      // Users can only read their own history
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Only authenticated users can create history entries
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cubeSize is int
        && request.resource.data.cubeSize >= 2
        && request.resource.data.cubeSize <= 10
        && request.resource.data.time is number
        && request.resource.data.time > 0;

      // History should not be updated or deleted
      allow update, delete: if false;
    }

    // ===== Activity Logs Collection =====
    match /logs/{logId} {
      // Only authenticated users can read logs
      allow read: if isAuthenticated();

      // Any authenticated user can create logs
      allow create: if isAuthenticated()
        && request.resource.data.userId is string;

      allow update, delete: if false;
    }

    // ===== Presence Collection =====
    match /presence/{userId} {
      // Anyone authenticated can read presence
      allow read: if isAuthenticated();

      // Users can only manage their own presence
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ===== Announcements Collection =====
    match /announcements/{announcementId} {
      // Anyone can read announcements
      allow read: if true;

      // Only authenticated users can create/update
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // ===== Deny all other collections =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
