rules_version = '2';

// =============================================================
// Firestore Security Rules for Word Cube Puzzle
// Deploy via: Firebase Console > Firestore > Rules
// Or via CLI: firebase deploy --only firestore:rules
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    function isValidCountry(code) {
      return code is string && code.size() == 2 && code.matches('^[A-Z]{2}$');
    }

    // ===== Users Collection =====
    match /users/{userId} {
      // Anyone can read user profiles (for leaderboard display)
      allow read: if true;

      // Users can only create/update their own profile
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['id', 'email', 'name', 'country', 'code', 'createdAt'])
        && isValidString(request.resource.data.name, 30)
        && isValidString(request.resource.data.email, 254)
        && isValidString(request.resource.data.code, 8);

      allow update: if isOwner(userId)
        && isValidString(request.resource.data.name, 30)
        // Prevent changing the id or email after creation
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email;

      // Users can only delete their own profile
      allow delete: if isOwner(userId);
    }

    // ===== Scores Collection =====
    match /scores/{scoreId} {
      // Anyone can read scores (leaderboard)
      allow read: if true;

      // Only authenticated users can create scores
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'userName', 'cubeSize', 'time', 'date', 'valid'])
        && isValidString(request.resource.data.userName, 30)
        && request.resource.data.cubeSize is int
        && request.resource.data.cubeSize >= 2
        && request.resource.data.cubeSize <= 10
        && request.resource.data.time is number
        && request.resource.data.time > 0
        && request.resource.data.time < 86400
        && request.resource.data.valid == true;

      // Scores should not be updated or deleted by users
      allow update, delete: if false;
    }

    // ===== Play History Collection =====
    match /history/{historyId} {
      // Users can only read their own history
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Only authenticated users can create history entries
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'cubeSize', 'time', 'date'])
        && request.resource.data.cubeSize is int
        && request.resource.data.cubeSize >= 2
        && request.resource.data.cubeSize <= 10
        && request.resource.data.time is number
        && request.resource.data.time > 0;

      // History should not be updated or deleted
      allow update, delete: if false;
    }

    // ===== Activity Logs Collection =====
    match /logs/{logId} {
      // Only admins can read logs (checked client-side, basic auth gate here)
      allow read: if isAuthenticated();

      // Any authenticated user can create logs
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['action', 'userId', 'timestamp']);

      allow update, delete: if false;
    }

    // ===== Presence Collection =====
    match /presence/{userId} {
      // Anyone can read presence (for admin online users view)
      allow read: if isAuthenticated();

      // Users can only update their own presence
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'userName', 'lastActive', 'status']);

      allow delete: if isOwner(userId);
    }

    // ===== Announcements Collection =====
    match /announcements/{announcementId} {
      // Anyone can read announcements
      allow read: if true;

      // Only authenticated users can create (admin check is client-side)
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['title', 'content', 'author', 'date', 'timestamp', 'active']);

      // Only authenticated users can update
      allow update: if isAuthenticated();

      allow delete: if false;
    }

    // ===== Deny all other collections =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
