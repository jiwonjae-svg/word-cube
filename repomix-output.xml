    --color-accent: #3b82f6; /* Sky Blue */
    --color-accent-secondary: #8b5cf6; /* Purple */
    --color-accent-hover: #2563eb;
    --color-success: #10b981;
    --color-warning: #f59e0b;
    --color-danger: #ef4444;
    --color-gold: #fbbf24;
    
    /* Light Glassmorphism */
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-bg-hover: rgba(255, 255, 255, 0.9);
    --glass-border: #e2e8f0;
    --glass-shadow: rgba(0, 0, 0, 0.05);
    
    /* Typography */
    --font-display: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', 'Courier New', monospace;
    
    /* Spacing */
    --spacing-xs: 8px;
    --spacing-sm: 12px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 32px;
}

body {
    font-family: var(--font-display);
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
    background-attachment: fixed;
    color: #1e293b;
    overflow: hidden;
    height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    
    /* Safe area for mobile notches */
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
}

/* Animated background gradient - Soft Light Theme */
body::before {
    content: '';
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 40%, rgba(59, 130, 246, 0.06) 0%, transparent 40%),
                radial-gradient(circle at 70% 60%, rgba(139, 92, 246, 0.04) 0%, transparent 40%);
    animation: rotateGradient 30s linear infinite;
    pointer-events: none;
    z-index: 0;
}

@keyframes rotateGradient {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* ============================================
   SCREEN CONTAINERS - 화면 전환 시스템
   ============================================ */
.screen-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.screen-container.active {
    opacity: 1;
}

/* ============================================
   GAME SCREEN - 즉시 시작
   ============================================ */
#game-screen {
    display: none;
    flex-direction: column;
    padding-bottom: 120px; /* Footer 높이만큼 여유 공간 확보 */
}

#game-screen.active {
    display: flex;
}

#header {
    position: relative;
    background: var(--glass-bg);
    backdrop-filter: blur(15px) saturate(180%);
    -webkit-backdrop-filter: blur(15px) saturate(180%);
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 
        0 4px 20px rgba(0, 0, 0, 0.05),
        inset 0 -1px 0 rgba(59, 130, 246, 0.05);
    border-bottom: 1px solid var(--glass-border);
    z-index: 100;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

#leaderboard-container {
    flex: 1;
    max-width: 450px;
}

#leaderboard-container h3 {
    margin-bottom: var(--spacing-md);
    color: var(--color-gold);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
    text-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
}

/* 리더보드 리스트 스타일은 .right-panel 섹션에서 정의됨 */

.leaderboard-entry {
    padding: var(--spacing-sm) var(--spacing-md);
    margin: var(--spacing-xs) 0;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    border: 1px solid rgba(59, 130, 246, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: var(--font-display);
    font-weight: 500;
}

.leaderboard-entry:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
}

.leaderboard-entry.highlight {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2) 0%, rgba(245, 158, 11, 0.2) 100%);
    border: 1px solid var(--color-gold);
    font-weight: 700;
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.2);
}

/* ===================
   AUTH SECTION - GLASSMORPHISM
   =================== */
#auth-container {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

#user-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    background: rgba(59, 130, 246, 0.05);
    border-radius: 50px;
    border: 1px solid rgba(59, 130, 246, 0.15);
    transition: all 0.3s ease;
}

#user-info:hover {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.3);
}

#user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
    transition: all 0.3s ease;
}

#user-avatar:hover {
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
}

#user-name {
    color: #1e293b;
    font-weight: 600;
    font-size: 14px;
}

.btn-primary, .btn-secondary {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-display);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.btn-primary::before,
.btn-secondary::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.btn-primary:active::before,
.btn-secondary:active::before {
    width: 300px;
    height: 300px;
}

.btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
}

.btn-primary:hover {
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
}

.btn-secondary {
    background: rgba(59, 130, 246, 0.08);
    backdrop-filter: blur(10px);
    color: #1e293b;
    border: 1px solid rgba(59, 130, 246, 0.2);
}

.btn-secondary:hover {
    background: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.15);
}

/* ===================
   GAME CONTAINER - Grid Item
   =================== */
#game-container {
    position: relative;
    z-index: 1;
}

/* Combo Glow Effect Container */
.combo-glow {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 50;
    opacity: 0;
    transition: opacity 0.5s ease;
}

.combo-glow.active {
    opacity: 1;
    box-shadow: 
        inset 0 0 60px rgba(251, 191, 36, 0.3),
        inset 0 0 100px rgba(251, 191, 36, 0.2);
    animation: neonPulse 2s ease-in-out infinite;
}

@keyframes neonPulse {
    0%, 100% { 
        box-shadow: 
            inset 0 0 60px rgba(251, 191, 36, 0.3),
            inset 0 0 100px rgba(251, 191, 36, 0.2);
    }
    50% { 
        box-shadow: 
            inset 0 0 80px rgba(251, 191, 36, 0.5),
            inset 0 0 130px rgba(251, 191, 36, 0.3);
    }
}

/* ===================
   WORD LIST PANEL - GLASSMORPHISM
   =================== */
#word-list-panel {
    position: fixed;
    right: var(--spacing-lg);
    top: 50%;
    transform: translateY(-50%);
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    padding: var(--spacing-xl);
    border-radius: 24px;
    border: 1px solid var(--glass-border);
    box-shadow: 
        0 8px 32px var(--glass-shadow),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    width: 280px;
    max-height: 85vh;
    overflow-y: auto;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 90;
}

#word-list-panel:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
}

#word-list-panel h3 {
    color: #1e293b;
    margin-bottom: var(--spacing-lg);
    text-align: center;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

#words-to-find {
    margin-bottom: var(--spacing-lg);
}

.word-item {
    padding: var(--spacing-md) var(--spacing-lg);
    margin: var(--spacing-sm) 0;
    background: rgba(59, 130, 246, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    color: #1e293b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(59, 130, 246, 0.15);
    position: relative;
    overflow: hidden;
}

.word-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.15), transparent);
    transition: left 0.5s;
}

.word-item:hover::before {
    left: 100%;
}

.word-item.found {
    background: rgba(16, 185, 129, 0.15);
    border-color: var(--color-success);
    text-decoration: line-through;
    opacity: 0.5;
}

.word-item:not(.found):hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.15);
}

/* ===================
   SCORE INFO - MONOSPACE NUMBERS
   =================== */
#score-info {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--spacing-lg);
    margin-top: var(--spacing-md);
}

.score-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
    font-size: 15px;
}

.score-item .label {
    font-weight: 600;
    color: #64748b;
    font-family: var(--font-display);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.score-item span:last-child {
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 18px;
    text-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
}

#multiplier {
    font-size: 22px !important;
    color: var(--color-gold) !important;
    text-shadow: 0 0 15px rgba(251, 191, 36, 0.5) !important;
    animation: multiplierGlow 1.5s ease-in-out infinite;
}

@keyframes multiplierGlow {
    0%, 100% { 
        transform: scale(1);
        text-shadow: 0 0 15px rgba(251, 191, 36, 0.5);
    }
    50% { 
        transform: scale(1.05);
        text-shadow: 0 0 25px rgba(251, 191, 36, 0.8);
    }
}

/* ===================
   LOADING & UTILITY
   =================== */
.loading {
    text-align: center;
    color: #94a3b8;
    font-style: italic;
    font-size: 14px;
    padding: var(--spacing-md);
}

/* ===================
   RESPONSIVE DESIGN
   =================== */
@media (max-width: 768px) {
    :root {
        --spacing-lg: 16px;
        --spacing-xl: 20px;
    }
    
    #header {
        flex-direction: column;
        gap: var(--spacing-md);
        padding: var(--spacing-md) var(--spacing-lg);
    }
    
    #leaderboard-container {
        max-width: 100%;
        width: 100%;
    }
    
    #word-list-panel {
        position: fixed;
        right: 10px;
        left: 10px;
        top: auto;
        bottom: calc(10px + env(safe-area-inset-bottom));
        transform: none;
        width: auto;
        max-height: 45vh;
        padding: var(--spacing-lg);
    }
    
    #game-container {
        padding: var(--spacing-sm);
    }
    
    .btn-primary, .btn-secondary {
        padding: var(--spacing-sm) var(--spacing-md);
        font-size: 13px;
    }
}

@media (max-width: 480px) {
    #leaderboard-container h3 {
        font-size: 16px;
    }
    
    .leaderboard-entry {
        font-size: 13px;
        padding: var(--spacing-xs) var(--spacing-sm);
    }
    
    #word-list-panel h3 {
        font-size: 18px;
    }
    
    .word-item {
        font-size: 14px;
        padding: var(--spacing-sm) var(--spacing-md);
    }
}

/* Landscape mode optimization */
@media (max-height: 600px) and (orientation: landscape) {
    #header {
        padding: var(--spacing-xs) var(--spacing-lg);
    }
    
    #word-list-panel {
        max-height: 70vh;
    }
}

/* ===================
   SCROLLBAR - GLASSMORPHISM
   =================== */
::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.5);
    border-radius: 10px;
    margin: 4px;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.6) 0%, rgba(118, 75, 162, 0.6) 100%);
    border-radius: 10px;
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: all 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.8) 0%, rgba(118, 75, 162, 0.8) 100%);
    background-clip: padding-box;
}

/* Firefox scrollbar */
* {
    scrollbar-width: thin;
    scrollbar-color: rgba(102, 126, 234, 0.6) rgba(15, 23, 42, 0.5);
}

/* ===================
   ANIMATIONS & EFFECTS
   =================== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes fadeOut {
    from {
        opacity: 1;
        transform: scale(1);
    }
    to {
        opacity: 0;
        transform: scale(0.95);
    }
}

.word-item {
    animation: fadeInUp 0.5s ease backwards;
}

.word-item:nth-child(1) { animation-delay: 0.05s; }
.word-item:nth-child(2) { animation-delay: 0.1s; }
.word-item:nth-child(3) { animation-delay: 0.15s; }
.word-item:nth-child(4) { animation-delay: 0.2s; }
.word-item:nth-child(5) { animation-delay: 0.25s; }
.word-item:nth-child(6) { animation-delay: 0.3s; }
.word-item:nth-child(7) { animation-delay: 0.35s; }
.word-item:nth-child(8) { animation-delay: 0.4s; }
.word-item:nth-child(9) { animation-delay: 0.45s; }
.word-item:nth-child(10) { animation-delay: 0.5s; }

.leaderboard-entry {
    animation: slideInRight 0.4s ease backwards;
}

.leaderboard-entry:nth-child(1) { animation-delay: 0.1s; }
.leaderboard-entry:nth-child(2) { animation-delay: 0.15s; }
.leaderboard-entry:nth-child(3) { animation-delay: 0.2s; }
.leaderboard-entry:nth-child(4) { animation-delay: 0.25s; }
.leaderboard-entry:nth-child(5) { animation-delay: 0.3s; }

/* ===================
   ACCESSIBILITY
   =================== */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    :root {
        --glass-bg: rgba(255, 255, 255, 0.15);
        --glass-border: rgba(255, 255, 255, 0.3);
    }
    
    .word-item,
    .leaderboard-entry {
        border-width: 2px;
    }
}

/* Dark mode (default) */
@media (prefers-color-scheme: dark) {
    /* Already optimized for dark mode */
}

/* Touch device optimization */
@media (hover: none) and (pointer: coarse) {
    .btn-primary,
    .btn-secondary,
    .btn-auth,
    .word-item:not(.found) {
        -webkit-tap-highlight-color: transparent;
    }
    
    .btn-primary:active,
    .btn-auth:active {
        transform: scale(0.95);
    }
    
    .word-item:not(.found):active {
        transform: translateX(4px) scale(0.98);
    }
}

/* ===================
   LOGIN SCREEN - RESPONSIVE
   =================== */
@media (max-width: 768px) {
    .login-container {
        max-width: 100%;
        padding: var(--spacing-lg);
        border-radius: 20px;
    }
    
    .login-title {
        font-size: 24px;
    }
    
    .logo-icon {
        font-size: 52px;
    }
}

@media (max-width: 480px) {
    #login-screen {
        padding: var(--spacing-md);
    }
    
    .login-container {
        padding: var(--spacing-md);
        border-radius: 16px;
    }
    
    .login-title {
        font-size: 22px;
    }
    
    .login-subtitle {
        font-size: 12px;
    }
    
    .glass-input {
        font-size: 14px;
        padding: var(--spacing-sm) var(--spacing-md);
    }
    
    .btn-auth {
        font-size: 14px;
        padding: var(--spacing-sm) var(--spacing-md);
    }
}

/* ============================================
   NEW LAYOUT SYSTEM - 오버랩 레이아웃
   ============================================ */

/* 메인 게임 영역 - Grid 3-Column Layout */
.game-main-area {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg);
    overflow: hidden;
    position: relative;
    z-index: 1;
    min-height: 0;
}

/* 사이드 패널 공통 스타일 - Soft Light Glassmorphism */
.side-panel {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 
        0 8px 24px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 1);
    padding: var(--spacing-xl);
    overflow-y: auto;
    transition: all 0.3s ease;
    position: relative;
    z-index: 10;
    margin: 24px 0;
    width: 260px;
    max-height: calc(100vh - 250px);
}

.side-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, 
        rgba(59, 130, 246, 0.02) 0%, 
        rgba(139, 92, 246, 0.01) 50%,
        rgba(59, 130, 246, 0.02) 100%);
    pointer-events: none;
    border-radius: 20px;
}

.side-panel:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(59, 130, 246, 0.25);
    box-shadow: 
        0 12px 32px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 1);
}

.side-panel h3 {
    color: #1e293b;
    margin-bottom: var(--spacing-xs);
    text-align: center;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    position: relative;
    z-index: 1;
}

.panel-subtitle {
    text-align: center;
    color: #64748b;
    font-size: 12px;
    margin-bottom: var(--spacing-lg);
    font-weight: 500;
}

/* 왼쪽 패널 (리더보드) - Grid Item */
.left-panel {
    justify-self: start;
    width: 280px;
    animation: slideInLeft 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slideInLeft {
    from {
        opacity: 0;
        transform: translateX(-30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* 오른쪽 패널 (단어 리스트) - Grid Item */
.right-panel {
    justify-self: end;
    width: 260px;
    height: calc(100vh - 200px);
    max-height: 85vh;
    min-height: 600px;
    animation: slideInRight 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
    animation: slideInRight 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

#leaderboard-panel h3 {
    color: var(--color-gold);
    text-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
    flex-shrink: 0;
}

.panel-subtitle {
    flex-shrink: 0;
}

#leaderboard-list {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    font-size: 14px;
    padding-right: var(--spacing-xs);
    min-height: 0;
}

/* 중앙 게임 컨테이너 - Perfect Grid Centering */
#game-container {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
}

/* 중앙 게임 컨테이너 - Grid Center Item */
#game-container {
    justify-self: center;
}

#game-container canvas {
    border-radius: 16px;
    box-shadow: 
        0 10px 30px rgba(0, 0, 0, 0.05),
        0 4px 12px rgba(59, 130, 246, 0.08),
        inset 0 0 0 1px rgba(59, 130, 246, 0.1);
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* ============================================
   FOOTER - 유리 바닥 위에 떠 있는 느낌
   ============================================ */
#footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--glass-bg);
    backdrop-filter: blur(15px) saturate(180%);
    -webkit-backdrop-filter: blur(15px) saturate(180%);
    padding: var(--spacing-lg) var(--spacing-xl);
    box-shadow: 
        0 -10px 30px rgba(0, 0, 0, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    border-top: 1px solid var(--glass-border);
    z-index: 1000;
}

.status-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
    max-width: 1000px;
    margin: 0 auto;
}

.status-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-lg);
    background: rgba(59, 130, 246, 0.05);
    border-radius: 16px;
    border: 1px solid rgba(59, 130, 246, 0.1);
    transition: all 0.3s ease;
}

.status-group:hover {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.2);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
}

.status-icon {
    font-size: 28px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
}

.status-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.status-label {
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.status-value {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    font-family: var(--font-mono);
}

.status-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, 
        transparent, 
        rgba(255, 255, 255, 0.2), 
        transparent
    );
}

/* ============================================
   DRAG FEEDBACK - 실시간 드래그 중 단어 표시
   ============================================ */
#drag-feedback {
    position: fixed;
    bottom: 120px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: 20px;
    border: 2px solid rgba(129, 140, 248, 0.3);
    box-shadow: 
        0 8px 32px var(--glass-shadow),
        inset 0 1px 0 rgba(129, 140, 248, 0.1),
        0 0 30px rgba(129, 140, 248, 0.2);
    z-index: 999;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.drag-label {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.drag-word {
    font-size: 24px;
    font-weight: 700;
    color: #818cf8;
    font-family: var(--font-mono);
    text-shadow: 0 2px 10px rgba(129, 140, 248, 0.4);
    letter-spacing: 0.1em;
    min-width: 60px;
    text-align: center;
}

/* ============================================
   LEADERBOARD ITEMS - 더미 데이터 스타일
   ============================================ */
.leaderboard-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    border: 1px solid rgba(59, 130, 246, 0.1);
    margin-bottom: var(--spacing-sm);
    transition: all 0.3s ease;
}

.leaderboard-item:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(59, 130, 246, 0.2);
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
}

.leaderboard-item .rank {
    min-width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: #475569;
    font-size: 14px;
}

.leaderboard-item.rank-1 .rank {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: #1e293b;
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.4);
}

.leaderboard-item.rank-2 .rank {
    background: linear-gradient(135deg, #e5e7eb 0%, #9ca3af 100%);
    color: #1e293b;
    box-shadow: 0 0 15px rgba(156, 163, 175, 0.3);
}

.leaderboard-item.rank-3 .rank {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #1e293b;
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
}

.leaderboard-item .player-name {
    flex: 1;
    color: #1e293b;
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.leaderboard-item .score {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 14px;
}

/* ============================================
   RESPONSIVE - 새로운 레이아웃
   ============================================ */
@media (max-width: 1200px) {
    .side-panel {
        width: 240px;
        padding: var(--spacing-lg);
    }
}

@media (max-width: 1024px) {
    .game-main-area {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
        padding: var(--spacing-md);
        gap: var(--spacing-md);
    }
    
    .left-panel,
    .right-panel {
        justify-self: stretch;
        width: 100%;
        max-height: 200px;
        margin: 12px 0;
    }
    
    .left-panel,
    .right-panel {
        animation: none;
    }
    
    .profile-card {
        flex-direction: row;
        justify-content: center;
    }
    
    .profile-stats {
        flex-direction: column;
        gap: var(--spacing-xs);
    }
}

@media (max-width: 768px) {
    #header {
        padding: var(--spacing-sm) var(--spacing-md);
    }
    
    .game-title {
        font-size: 16px;
    }
    
    .game-main-area {
        padding: var(--spacing-sm);
    }
    
    .side-panel {
        padding: var(--spacing-md);
        border-radius: 16px;
    }
    
    .side-panel h3 {
        font-size: 16px;
    }
    
    #footer {
        padding: var(--spacing-sm) var(--spacing-md);
    }
    
    .profile-avatar {
        width: 48px;
        height: 48px;
    }
    
    .profile-name {
        font-size: 16px;
    }
    
    .stat-item {
        font-size: 12px;
    }
}
