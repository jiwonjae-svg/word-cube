          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
      </div>
    </header>

    <!-- Mobile Action Bar (visible only on mobile, below header) -->
    <div class="mobile-action-bar">
      <button id="mobile-undo-btn" class="icon-btn" title="Undo" disabled>
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 10h10a5 5 0 015 5v2"/><path d="M3 10l5-5M3 10l5 5"/></svg>
      </button>
      <button id="mobile-redo-btn" class="icon-btn" title="Redo" disabled>
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10H11a5 5 0 00-5 5v2"/><path d="M21 10l-5-5M21 10l-5 5"/></svg>
      </button>
      <button id="mobile-words-btn" class="glass-btn secondary-btn small-btn">Words</button>
      <button id="mobile-ranking-btn" class="glass-btn secondary-btn small-btn">Ranking</button>
      <button id="mobile-new-game-btn" class="glass-btn secondary-btn small-btn" style="display:none;">New Game</button>
    </div>

    <!-- Main Content -->
    <main class="game-main">
      <!-- Leaderboard Panel -->
      <aside class="side-panel leaderboard-panel glass-panel">
        <h2>Leaderboard</h2>
        <p class="panel-subtitle" id="leaderboard-size">Cube: 3&times;3</p>
        <div id="leaderboard-list" class="leaderboard-list">
          <!-- Populated dynamically -->
        </div>
      </aside>

      <!-- Cube Area -->
      <section class="cube-section">
        <div class="timer-bar glass-panel" id="timer-bar">
          <span id="timer-display">00:00.0</span>
        </div>
        <div id="cube-container"></div>

        <!-- Size Selector Overlay -->
        <div id="size-selector" class="size-selector glass-panel">
          <h2>Select Cube Size</h2>
          <div class="size-grid" id="size-grid">
            <!-- 3x3 to 10x10 buttons generated dynamically -->
          </div>
          <button id="start-game-btn" class="glass-btn primary-btn large-btn" disabled>Start Game</button>
        </div>

        <!-- Game Complete Overlay -->
        <div id="game-complete" class="game-complete-overlay hidden">
          <div class="glass-panel complete-card">
            <h2>Puzzle Complete!</h2>
            <p class="complete-time" id="complete-time">00:00.0</p>
            <p class="complete-msg">All words found!</p>
            <button id="play-again-btn" class="glass-btn primary-btn">Play Again</button>
          </div>
        </div>

        <!-- Scramble Overlay -->
        <div id="scramble-overlay" class="size-selector glass-panel hidden">
          <h2>Ready?</h2>
          <p style="margin-bottom:20px;color:var(--text-light);font-size:14px;">Review the solved cube and word list, then scramble!</p>
          <button id="scramble-btn" class="glass-btn primary-btn large-btn">Scramble &amp; Start!</button>
        </div>
      </section>

      <!-- Word List Panel -->
      <aside class="side-panel wordlist-panel glass-panel">
        <h2>Words to Find</h2>
        <div id="word-list" class="word-list">
          <!-- Populated dynamically -->
        </div>
      </aside>
    </main>

    <!-- Footer -->
    <footer class="game-footer glass-panel">
      <div class="footer-left">
        <button id="profile-btn" class="glass-btn profile-btn">
          <span id="user-profile-display">&#127760; Player #00000000</span>
        </button>
        <button id="logout-btn" class="glass-btn secondary-btn small-btn">Logout</button>
      </div>
      <div class="footer-right"></div>
    </footer>
  </div>

  <!-- ==================== MODALS ==================== -->

  <!-- Settings Modal -->
  <div id="settings-modal" class="modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content glass-panel">
      <div class="modal-header">
        <h2>Settings</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <div class="setting-item">
          <label for="setting-sensitivity">Rotation Sensitivity</label>
          <div class="setting-control">
            <input type="range" id="setting-sensitivity" min="1" max="10" value="5" step="1">
            <span class="range-value" id="sensitivity-value">5</span>
          </div>
        </div>
        <div class="setting-item">
          <label for="setting-invert">Invert Rotation</label>
          <div class="setting-control">
            <label class="toggle-switch">
              <input type="checkbox" id="setting-invert">
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
        <div class="setting-item">
          <label for="setting-feedback">Click Feedback</label>
          <div class="setting-control">
            <label class="toggle-switch">
              <input type="checkbox" id="setting-feedback" checked>
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Help Modal -->
  <div id="help-modal" class="modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content glass-panel">
      <div class="modal-header">
        <h2>How to Play</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body help-body">
        <div class="help-section">
          <h3>Objective</h3>
          <p>Find all hidden words on the cube faces by rotating the cube's rows and columns to align letters.</p>
        </div>
        <div class="help-section">
          <h3>Controls</h3>
          <ul>
            <li><strong>Right-click + drag:</strong> Rotate the view to see different faces</li>
            <li><strong>Left-click + drag on a tile:</strong> Rotate that row or column</li>
            <li><strong>Scroll:</strong> Zoom in/out</li>
          </ul>
        </div>
        <div class="help-section">
          <h3>Rules</h3>
          <ul>
            <li>Words can appear horizontally or vertically on any face</li>
            <li>Rotating a row/column shifts letters between adjacent faces</li>
            <li>Found words glow and pop out temporarily</li>
            <li>Complete the puzzle by finding all words!</li>
          </ul>
        </div>
        <div class="help-section">
          <h3>Keyboard Shortcuts</h3>
          <ul>
            <li><strong>Ctrl + Z:</strong> Undo last move</li>
            <li><strong>Ctrl + Y / Ctrl + Shift + Z:</strong> Redo move</li>
            <li><strong>Escape:</strong> Close any modal</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Profile Menu -->
  <div id="profile-menu" class="dropdown-menu hidden">
    <button id="profile-edit-btn" class="dropdown-item">Edit Profile</button>
    <button id="profile-history-btn" class="dropdown-item">Play History</button>
  </div>

  <!-- Profile Edit Modal -->
  <div id="profile-edit-modal" class="modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content glass-panel">
      <div class="modal-header">
        <h2>Edit Profile</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <div class="profile-avatar-section">
          <div class="avatar-preview" id="avatar-preview">?</div>
          <input type="file" id="avatar-upload" accept="image/*" hidden>
          <button id="avatar-upload-btn" class="glass-btn secondary-btn small-btn">Change Image</button>
        </div>
        <div class="input-group">
          <label>Display Name</label>
          <input type="text" id="edit-name" class="glass-input" placeholder="Display Name">
        </div>
        <div class="input-group">
          <label>Country</label>
          <select id="edit-country" class="glass-input">
            <option value="US">US - United States</option>
            <option value="GB">GB - United Kingdom</option>
            <option value="KR">KR - South Korea</option>
            <option value="JP">JP - Japan</option>
            <option value="DE">DE - Germany</option>
            <option value="FR">FR - France</option>
            <option value="CN">CN - China</option>
            <option value="BR">BR - Brazil</option>
            <option value="IN">IN - India</option>
            <option value="CA">CA - Canada</option>
            <option value="AU">AU - Australia</option>
            <option value="ES">ES - Spain</option>
            <option value="IT">IT - Italy</option>
            <option value="MX">MX - Mexico</option>
            <option value="RU">RU - Russia</option>
          </select>
        </div>
        <button id="save-profile-btn" class="glass-btn primary-btn">Save</button>
      </div>
    </div>
  </div>

  <!-- Play History Modal -->
  <div id="history-modal" class="modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content glass-panel wide-modal">
      <div class="modal-header">
        <h2>Play History</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Size</th>
              <th>Time</th>
              <th>Seed</th>
            </tr>
          </thead>
          <tbody id="history-list">
            <!-- Populated dynamically -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Mobile Words Modal -->
  <div id="mobile-words-modal" class="mobile-panel-modal hidden">
    <div class="mobile-panel-overlay"></div>
    <div class="mobile-panel-content glass-panel">
      <div class="modal-header">
        <h2>Words to Find</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div id="mobile-word-list" class="word-list"></div>
    </div>
  </div>

  <!-- Mobile Ranking Modal -->
  <div id="mobile-ranking-modal" class="mobile-panel-modal hidden">
    <div class="mobile-panel-overlay"></div>
    <div class="mobile-panel-content glass-panel">
      <div class="modal-header">
        <h2>Leaderboard</h2>
        <p class="panel-subtitle" id="mobile-leaderboard-size">Cube: 3&times;3</p>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div id="mobile-leaderboard-list" class="leaderboard-list"></div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast-container"></div>

  <!-- New Game Confirm Modal -->
  <div id="newgame-modal" class="modal hidden">
    <div class="modal-overlay"></div>
    <div class="modal-content glass-panel" style="max-width:380px;">
      <div class="modal-header">
        <h2>Start New Game?</h2>
        <button class="modal-close-btn">&times;</button>
      </div>
      <div class="modal-body">
        <p style="color:var(--text-light);font-size:14px;margin-bottom:16px;">Your current progress will be lost. Are you sure you want to start a new game?</p>
        <div style="display:flex;gap:10px;">
          <button id="newgame-cancel-btn" class="glass-btn secondary-btn" style="flex:1;">Cancel</button>
          <button id="newgame-confirm-btn" class="glass-btn primary-btn" style="flex:1;background:linear-gradient(135deg,var(--danger),#f87171);border-color:transparent;">New Game</button>
        </div>
      </div>
    </div>
  </div>

